<% dummy_page_nav(title: "Share", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Share a page",
    subtitle: "The public press kit, and the list that shows drafts waiting their turn.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Press kit",
          subtitle: "The published page with a share button.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6">
          Open the public page. Copy the link, or hand it to LinkedIn, X, Facebook, or email.
        </p>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "Open press kit",
          style: :primary,
          size: :md,
          href: press_path
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Page list",
          subtitle: "Published, draft, and scheduled, side by side.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6">
          Sharing stays off until a page is public. Drafts and scheduled pages say why.
        </p>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "Open pages",
          style: :secondary,
          size: :md,
          href: pages_path
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
