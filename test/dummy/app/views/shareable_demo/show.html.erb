<% content_for :title, "Shareable" %>
<% content_for :head do %>
  <%= shareable_head_tags(@page) %>
<% end %>
<% dummy_page_nav(title: "Shareable", back_url: root_path) %>

<div class="flex w-full flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Shareable demo",
    subtitle: "Page uses a host public_url. Publishable is not enabled. Folder is not opted in.",
    variant: :h1
  ) %>

  <section id="share-payload" class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Resolved payload</h2>
    <dl class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="font-medium">Record</dt>
      <dd>Page · <%= @page.title %></dd>
      <dt class="font-medium">Availability</dt>
      <dd id="payload-availability"><%= @page_payload.available? ? "Available" : "Unavailable" %></dd>
      <dt class="font-medium">URL</dt>
      <dd id="payload-url" class="break-all"><%= @page_payload.url %></dd>
      <dt class="font-medium">Title</dt>
      <dd id="payload-title"><%= @page_payload.title %></dd>
      <dt class="font-medium">Description</dt>
      <dd id="payload-description"><%= @page_payload.description.presence || "None" %></dd>
    </dl>
  </section>

  <section id="destination-links" class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Destination links</h2>
    <ul class="flex flex-col gap-3 text-sm">
      <% @page_payload.destinations.each do |name| %>
        <% url = @page_payload.destination_urls[name] %>
        <li class="break-all">
          <span class="font-medium"><%= name %></span>
          <% if url %>
            <a id="destination-<%= name %>" href="<%= url %>" class="block text-(--surface-link-color,inherit) underline"><%= url %></a>
          <% else %>
            <span id="destination-<%= name %>">No URL</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <section id="head-tags" class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">shareable_head_tags</h2>
    <pre id="head-tags-output" class="overflow-x-auto whitespace-pre-wrap break-all rounded border border-(--surface-border-color) p-4 text-xs"><%== CGI.escapeHTML(shareable_head_tags(@page).to_s) %></pre>
  </section>

  <section id="share-unavailable" class="flex flex-col gap-3">
    <h2 class="text-lg font-semibold">Unavailable</h2>
    <p class="text-sm">Folder is not opted into Shareable, so this payload has no URL, no destination links, and no head tags.</p>
    <dl class="grid grid-cols-[9rem_1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="font-medium">Record</dt>
      <dd>Folder · <%= @folder.name %></dd>
      <dt class="font-medium">Availability</dt>
      <dd id="unavailable-availability"><%= @folder_payload.available? ? "Available" : "Unavailable" %></dd>
      <dt class="font-medium">URL</dt>
      <dd id="unavailable-url"><%= @folder_payload.url.presence || "None" %></dd>
      <dt class="font-medium">Destination links</dt>
      <dd id="unavailable-links"><%= @folder_payload.destination_urls.presence&.keys&.join(", ") || "None" %></dd>
      <dt class="font-medium">Head tags</dt>
      <dd id="unavailable-head-tags"><%= shareable_head_tags(@folder).presence || "Empty" %></dd>
    </dl>
  </section>
</div>
